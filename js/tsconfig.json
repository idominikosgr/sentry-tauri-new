{
  "compilerOptions": {
    "target": "esnext",
    "strict": true,
    "lib": ["ESNext", "DOM"],
    "noEmitOnError": true,
    "isolatedModules": true,
    // module resolution
    "esModuleInterop": true,
    "moduleResolution": "node",
    // advanced
    "skipLibCheck": true,
    "rootDir": "./",
    "outDir": "../dist/",
    "declaration": true
  },
  "exclude": ["node_modules"],
  "include": ["./**/*"]
}
